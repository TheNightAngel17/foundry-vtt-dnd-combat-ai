<form class="actor-actions-dialog-form standard-form">
    <div class="dialog-header">
        <h2>{{actor.name}} - AI Action Descriptions</h2>
    </div>

    <div class="control-buttons form-group">
        <button type="button" data-action="generateAI">
            <i class="fas fa-magic"></i> Generate with AI
        </button>
        <button type="button" data-action="addAction">
            <i class="fas fa-plus"></i> Add Action
        </button>
    </div>

    {{#if hasActions}}
    <div class="actions-list">
        {{#each actions}}
        <fieldset>
            <div class="form-group">
                <label>Name</label>
                <div class="form-fields">
                    <input type="text" 
                           name="action-{{@index}}-name" 
                           value="{{this.name}}" 
                           placeholder="Action Name"
                           class="action-name-input"/>
                    <button type="button" data-action="deleteAction" data-index="{{@index}}" title="Delete Action">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>

            <div class="form-group">
                <label>Description</label>
                <div class="form-fields">
                    <textarea name="action-{{@index}}-description" 
                              rows="3"
                              maxlength="500"
                              placeholder="Action description..."
                              class="action-description-input">{{this.description}}</textarea>
                </div>
            </div>
            
            <div class="form-group">
                <label>Activation</label>
                <div class="form-fields">
                    <select name="action-{{@index}}-activationTime" class="action-select">
                        {{#each ../activationTypes}}
                        <option value="{{this.value}}" {{#if (eq this.value ../this.activationTime)}}selected{{/if}}>
                            {{this.label}}
                        </option>
                        {{/each}}
                    </select>
                </div>
            </div>
            
                    
            <div class="form-group">
                <label>Type</label>
                <div class="form-fields">
                    <select name="action-{{@index}}-itemType" class="action-select">
                        {{#each ../itemTypes}}
                        <option value="{{this.value}}" {{#if (eq this.value ../this.itemType)}}selected{{/if}}>
                            {{this.label}}
                        </option>
                        {{/each}}
                    </select>
                </div>
            </div>
        </fieldset>
        {{/each}}
    </div>
    {{else}}
    <div class="no-actions">
        <p><i class="fas fa-info-circle"></i> No actions configured. Click "Generate with AI" or "Add Action" to get started.</p>
    </div>
    {{/if}}

    <footer class="form-footer">
        <button type="button" data-action="save" {{#unless hasActions}}disabled{{/unless}}>
            <i class="fas fa-save"></i> Save Changes
        </button>
    </footer>

</form>
