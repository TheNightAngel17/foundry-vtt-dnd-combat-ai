<div class="turn-description-form">
    <div class="form-group">
        <label for="description">Describe what is happening this turn:</label>
        <textarea 
            id="description" 
            name="description" 
            rows="20" 
            style="width: 100%; font-family: monospace; resize: vertical;"
        >{{description}}</textarea>
    </div>
    <p style="font-size: 0.9em; color: #666; margin-top: 10px;">
        Edit the description as the turn progresses. Click "End Turn" when ready to advance.
    </p>
</div>
