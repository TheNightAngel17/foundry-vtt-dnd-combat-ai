<form class="ddb-importer-config-form">
    <p class="notes">Configure D&D Beyond Importer integration settings.</p>

    <div class="form-group">
        <label for="useDDBImporter">
            <input type="checkbox" name="useDDBImporter" {{checked useDDBImporter}} />
            Use DDB Importer
        </label>
        <p class="hint">Enable D&D Beyond Importer integration for importing character data</p>
    </div>

    <div class="form-group">
        <label for="ddbImporterUrl">DDB Importer URL</label>
        <input type="text" name="ddbImporterUrl" value="{{ddbImporterUrl}}" placeholder="https://proxy.ddb.mrprimate.co.uk" />
        <p class="hint">The URL endpoint for the DDB Importer service</p>
    </div>

    <div class="form-group">
        <label for="cobaltSession">Cobalt Session</label>
        <input type="password" name="cobaltSession" value="{{cobaltSession}}" placeholder="Enter your cobalt session token" />
        <p class="hint">Your D&D Beyond cobalt session token for authentication</p>
    </div>

    <button type="submit" name="submit">
        <i class="fas fa-save"></i> Save Configuration
    </button>
</form>
